-- Helper UI Functions
local function createCategoryLabel(text, yPos)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.9, 0, 0, 20)
    lbl.Position = UDim2.new(0.05, 0, 0, yPos)
    lbl.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    lbl.Text = "--- " .. text .. " ---"
    lbl.TextColor3 = Color3.fromRGB(0, 220, 255)
    lbl.TextSize = 11
    lbl.Font = Enum.Font.SourceSansBold
    lbl.Parent = ScrollFrame
    return lbl
end

local function createButton(text, yPos, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 26)
    btn.Position = UDim2.new(0.05, 0, 0, yPos)
    btn.BackgroundColor3 = color or Color3.fromRGB(50, 50, 50)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSans
    btn.Parent = ScrollFrame
    return btn
end

local function createTextBox(text, yPos)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0.9, 0, 0, 26)
    box.Position = UDim2.new(0.05, 0, 0, yPos)
    box.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    box.Text = text
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.Font = Enum.Font.SourceSans
    box.Parent = ScrollFrame
    return box
end

